import { ListView, ScrollView } from "std-widgets.slint";

export struct Album { key: string, title: string, artist: string, year: string, art: image, }
export struct AlbumRow { offset: int, count: int, heading: string, has-year: bool, }
export struct Track { key: string, number: int, title: string, time: string, }
export struct PlaylistCard { name: string, count: int, artwork: image, has-art: bool, }
export struct QueueTrack { title: string, artist: string, album: string, album-key: string, time: string, number: int, art: image, }
export struct SongHit { album-key: string, track-index: int, number: int, title: string, description: string, time: string, art: image, }
export struct QueueLine { index: int, height: int, gap: int, grouped: bool, track: QueueTrack, number: int, }
export struct LyricLine { text: string, time: float, y: float, height: float, }
export struct MenuEntry { label: string, icon: image, danger: bool, }

export global Palette {
    in property <color> text: #e8eef4;
    in property <color> muted: #9ca8b8;
    in property <color> background: #0f172a;
    in property <color> panel: #1c2c50;
    in property <color> border: #243866;
    in property <color> surface: #1c2c50;
    in property <color> hover: #233452;
    in property <color> selected: #28477d;
    in property <color> accent: #264ba2;
    in property <color> accent-text: #e8eef4;
    in property <color> accent-ink: #9cbae8;
    out property <color> sidebar: background.mix(surface, 0.55);
    out property <color> glass: surface.with-alpha(0.72);
    out property <color> glass-hover: hover.with-alpha(0.88);
    out property <color> hairline: text.with-alpha(0.10);
    // Soft vertical sheen for floating glass panels (sidebar, player bar, cards).
    out property <brush> glass-sheen: @linear-gradient(180deg, surface.with-alpha(0.80) 0%, surface.with-alpha(0.58) 100%);
}

component Label inherits Text {
    color: Palette.text;
    vertical-alignment: center;
    overflow: elide;
}

component LineEdit inherits Rectangle {
    in-out property <string> text <=> field.text;
    in property <string> placeholder-text;
    in property <color> field-color: Palette.background;
    in property <InputType> input-type <=> field.input-type;
    in property <length> font-size: 14px;
    in property <int> font-weight: 400;
    callback accepted;
    callback edited(string);
    callback cancelled;
    callback focus-lost;
    public function grab-focus() { field.focus(); }
    public function select-all() { field.select-all(); }
    forward-focus: field;
    height: 34px;
    vertical-stretch: 0;
    min-width: 80px;
    horizontal-stretch: 1;
    border-radius: 12px;
    border-width: 1px;
    border-color: field.has-focus ? Palette.accent-ink : Palette.hairline;
    background: field-color;
    clip: true;
    accessible-role: text-input;
    accessible-label: placeholder-text;
    accessible-value: input-type == InputType.password ? "" : text;
    accessible-placeholder-text: placeholder-text;
    accessible-action-set-value(value) => { root.text = value; root.edited(value); }
    Label {
        x: 14px; width: parent.width - 28px; height: parent.height;
        text: root.placeholder-text; color: Palette.muted;
        font-size: root.font-size; font-weight: root.font-weight;
        visible: root.text == "";
    }
    keys := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancelled(); return accept; }
            return reject;
        }
        field := TextInput {
            accessible-role: none;
            x: 14px; y: 0px; width: max(0px, root.width - 28px); height: root.height;
            single-line: true;
            vertical-alignment: center;
            color: Palette.text;
            font-size: root.font-size; font-weight: root.font-weight;
            selection-foreground-color: Palette.accent-text;
            selection-background-color: Palette.accent;
            accepted => { root.accepted(); }
            edited => { root.edited(self.text); }
            changed has-focus => { if !self.has-focus { root.focus-lost(); } }
        }
    }
}

component ComboBox inherits Rectangle {
    in property <[string]> model;
    in property <color> field-color: Palette.background;
    in-out property <int> current-index: 0;
    callback selected;
    height: 34px;
    vertical-stretch: 0;
    border-radius: 12px;
    border-width: 1px;
    border-color: keyboard.has-focus ? Palette.accent-ink : Palette.hairline;
    background: hit.has-hover ? Palette.hover : field-color;
    accessible-role: combobox;
    accessible-value: model[current-index];
    accessible-action-default => { choices.show(); }
    function select(index: int) {
        if index >= 0 && index < model.length {
            current-index = index;
            selected();
        }
    }
    Label { x: 10px; width: max(0px, parent.width - 34px); height: parent.height; text: root.model[root.current-index]; }
    Path {
        x: parent.width - 19px; y: (parent.height - self.height) / 2;
        width: 8px; height: 5px; viewbox-width: 8; viewbox-height: 5;
        commands: "M 0 0 L 4 4 L 8 0"; stroke: Palette.text; stroke-width: 1.5px;
    }
    hit := TouchArea { mouse-cursor: pointer; clicked => { keyboard.focus(); choices.show(); } }
    keyboard := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.DownArrow { root.select(root.current-index + 1); return accept; }
            if event.text == Key.UpArrow { root.select(root.current-index - 1); return accept; }
            if event.text == Key.Return || event.text == " " { choices.show(); return accept; }
            return reject;
        }
    }
    choices := PopupWindow {
        x: 0px; y: root.height + 3px;
        width: root.width; height: root.model.length * 32px + 8px;
        close-policy: close-on-click-outside;
        forward-focus: menu-keys;
        menu-keys := FocusScope {
            key-pressed(event) => {
                if event.text == Key.DownArrow { root.select(root.current-index + 1); return accept; }
                if event.text == Key.UpArrow { root.select(root.current-index - 1); return accept; }
                if event.text == Key.Return || event.text == Key.Escape { choices.close(); return accept; }
                return reject;
            }
        }
        Rectangle {
            border-radius: 14px; border-width: 1px;
            border-color: Palette.hairline; background: Palette.surface;
            drop-shadow-color: #00000055; drop-shadow-blur: 24px; drop-shadow-offset-y: 8px;
            VerticalLayout {
                padding: 4px;
                for name[index] in root.model: Rectangle {
                    height: 32px; border-radius: 9px;
                    background: option.has-hover ? Palette.hover : index == root.current-index ? Palette.selected : transparent;
                    Label { x: 6px; width: max(0px, parent.width - 12px); height: parent.height; text: name; }
                    option := TouchArea { mouse-cursor: pointer; clicked => { root.select(index); choices.close(); } }
                }
            }
        }
    }
}

component Artwork inherits Image {
    x: 0px;
    y: 0px;
    image-fit: contain;
}

component Action inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> muted-label;
    in property <int> text-weight: 500;
    in property <length> font-size: 14px;
    in property <bool> danger;
    in property <color> fill: Palette.glass;
    callback clicked;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { clicked(); }
    height: 38px;
    border-radius: 12px;
    background: active ? Palette.selected : hit.has-hover ? Palette.glass-hover : root.fill;
    animate background { duration: 120ms; easing: ease-out; }
    border-width: 1px;
    border-color: active ? Palette.text.with-alpha(0.16) : Palette.hairline;
    Label { text: root.label; color: root.active ? Palette.text : root.danger ? #ef4444 : root.muted-label ? Palette.muted : Palette.text; horizontal-alignment: center; font-weight: root.text-weight; font-size: root.font-size; }
    @children
    hit := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected;
    in property <bool> filled;
    in property <bool> compact;
    in property <bool> highlighted;
    in property <bool> outlined;
    in property <string> badge;
    callback clicked;
    border-radius: compact ? 20px : 14px;
    background: filled ? Palette.text : selected ? Palette.selected : hit.has-hover ? Palette.glass-hover : outlined ? Palette.glass : transparent;
    border-width: outlined ? 1px : 0px;
    border-color: Palette.hairline;
    drop-shadow-color: filled ? #00000040 : transparent; drop-shadow-blur: 12px; drop-shadow-offset-y: 3px;
    animate background { duration: 120ms; easing: ease-out; }
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { clicked(); }
    if badge == "": Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: outlined ? 14px : compact ? 16px : 16px;
        height: self.width;
        source: root.icon;
        colorize: filled ? Palette.background : selected ? Palette.text : highlighted ? Palette.accent-ink : compact ? Palette.text : Palette.muted;
    }
    if badge != "": Label {
        text: root.badge; font-weight: 700; font-size: 12px;
        color: root.selected ? Palette.accent-text : Palette.accent-ink; horizontal-alignment: center;
    }
    hit := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component PlayerRange inherits Rectangle {
    in property <float> value;
    in property <float> maximum: 1;
    in property <string> label;
    in property <bool> updates-live;
    in property <bool> show-knob;
    in property <bool> smooth;
    callback committed(float);
    property <float> preview;
    // Eases between position updates so playback progress moves continuously.
    property <float> shown: root.value;
    animate shown { duration: root.smooth ? 160ms : 0ms; easing: linear; }
    height: 20px;
    accessible-role: slider;
    accessible-label: label;
    accessible-value: value + "";
    track := Rectangle {
        x: 0px; y: (parent.height - self.height) / 2;
        width: parent.width; height: root.show-knob ? 6px : 4px; border-radius: 2px; background: root.show-knob ? Palette.text.with-alpha(0.18) : Palette.text.with-alpha(0.14);
        if !root.show-knob: Rectangle { x: 0px; y: 0px; height: parent.height; width: min(parent.width, max(0px, parent.width * (hit.pressed ? root.preview : root.shown) / max(0.01, root.maximum))); border-radius: 2px; background: Palette.text; }
    }
    if root.show-knob: Rectangle {
        width: 14px; height: 14px; border-radius: 7px;
        x: (parent.width - self.width) * clamp((hit.pressed ? root.preview : root.shown) / root.maximum, 0, 1);
        y: (parent.height - self.height) / 2;
        background: Palette.text; border-width: 1px; border-color: Palette.background.with-alpha(0.5);
        drop-shadow-color: #00000040; drop-shadow-blur: 4px; drop-shadow-offset-y: 1px;
    }
    hit := TouchArea {
        mouse-cursor: pointer;
        moved => {
            if self.pressed {
                root.preview = clamp(self.mouse-x / root.width, 0, 1) * root.maximum;
                if root.updates-live { root.committed(root.preview); }
            }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.preview = clamp(self.mouse-x / root.width, 0, 1) * root.maximum;
                focus.focus();
                if root.updates-live { root.committed(root.preview); }
            }
            if event.kind == PointerEventKind.up {
                root.committed(clamp(self.mouse-x / root.width, 0, 1) * root.maximum);
            }
        }
    }
    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.LeftArrow {
                root.committed(max(0, root.value - root.maximum * 0.05));
                return accept;
            }
            if event.text == Key.RightArrow {
                root.committed(min(root.maximum, root.value + root.maximum * 0.05));
                return accept;
            }
            return reject;
        }
    }
}

component EqBandSlider inherits Rectangle {
    in property <float> value;
    in property <string> label;
    callback changed(float);
    height: 100px;
    accessible-role: slider;
    accessible-label: label;
    accessible-value: value + " dB";
    Rectangle {
        x: (parent.width - self.width) / 2; y: 0px;
        width: 6px; height: parent.height; border-radius: 3px;
        background: Palette.text.with-alpha(0.18);
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) * (12 - clamp(root.value, -12, 12)) / 24;
        width: 14px; height: 14px; border-radius: 7px;
        background: Palette.text; border-width: 1px;
        border-color: keys.has-focus ? Palette.accent-ink : Palette.background.with-alpha(0.5);
    }
    hit := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                keys.focus();
                root.changed(round(clamp(12 - 24 * self.mouse-y / self.height, -12, 12)));
            }
        }
        moved => {
            if self.pressed { root.changed(round(clamp(12 - 24 * self.mouse-y / self.height, -12, 12))); }
        }
    }
    keys := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.UpArrow { root.changed(min(12, root.value + 1)); return accept; }
            if event.text == Key.DownArrow { root.changed(max(-12, root.value - 1)); return accept; }
            return reject;
        }
    }
}

component ReorderGrip inherits Rectangle {
    in property <int> index;
    in property <int> first;
    in property <int> last;
    in property <length> row-height;
    callback target(int);
    callback reorder(int);
    pure callback map-distance(float) -> int;
    in property <bool> uneven-rows;
    in property <bool> show-handle: true;
    out property <bool> hovered: grip-input.has-hover;
    property <int> destination: -1;
    width: 24px;
    accessible-role: button;
    accessible-label: "Drag to reorder";
    out property <bool> dragging: root.destination >= 0;
    Image {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: 14px; height: 14px; source: @image-url("icons/grip.svg"); colorize: Palette.muted;
        opacity: root.show-handle || root.dragging ? 1 : 0;
        animate opacity { duration: 150ms; }
    }
    grip-input := TouchArea {
        mouse-cursor: self.pressed ? grabbing : grab;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.destination = root.index;
                root.target(root.index);
            } else if event.kind == PointerEventKind.up && root.destination >= 0 {
                let destination = root.destination;
                root.destination = -1;
                root.target(-1);
                if destination != root.index { root.reorder(destination - root.index); }
            } else if event.kind == PointerEventKind.cancel {
                root.destination = -1;
                root.target(-1);
            }
        }
        moved => {
            if self.pressed && root.destination >= 0 {
                root.destination = root.uneven-rows
                    ? root.map-distance((self.mouse-y - self.pressed-y) / 1px)
                    : clamp(root.index + round((self.mouse-y - self.pressed-y) / root.row-height), root.first, root.last);
                root.target(root.destination);
            }
        }
    }
}

// Now-playing mark: four bars that follow the playing audio, or a play triangle while paused.
component NowPlayingMark inherits Rectangle {
    in property <[float]> levels;
    in property <bool> playing;
    in property <color> ink: Palette.text.with-alpha(0.85);
    if !root.playing: Image {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: 10px; height: 10px; source: @image-url("icons/play.svg"); colorize: root.ink;
    }
    if root.playing: Rectangle {
        for i in 4: Rectangle {
            property <float> level: i < root.levels.length ? root.levels[i] : 0;
            width: (root.width - 6px) / 4;
            x: i * (self.width + 2px);
            height: root.height * clamp(self.level, 0.15, 1);
            y: root.height - self.height;
            border-radius: 1px;
            background: root.ink;
            animate height { duration: 80ms; easing: ease-out; }
        }
    }
}

// One lyric line; state -1 sung earlier, 0 current (or unsynced), 1 upcoming.
component LyricRow inherits Rectangle {
    in property <LyricLine> line;
    in property <int> state;
    in property <float> fade: 1;
    callback jump;
    opacity: root.fade;
    Text {
        width: parent.width; height: parent.height;
        text: root.line.text; wrap: word-wrap; vertical-alignment: top;
        font-size: 34px; font-weight: 700;
        color: root.state == 0 ? Palette.text : Palette.muted;
        opacity: root.state == 0 ? 1 : root.state < 0 ? 0.45 : 0.65;
        animate color, opacity { duration: 220ms; }
    }
    if root.line.time >= 0: TouchArea { mouse-cursor: pointer; clicked => { root.jump(); } }
}

// Round translucent button with a fine highlight edge, used over the Now Playing view.
component GlassButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    in property <angle> icon-rotation;
    callback clicked;
    border-radius: self.height / 2 - 4px;
    background: root.active ? Palette.selected : hit.has-hover ? Palette.glass-hover : Palette.glass;
    border-width: 1px; border-color: Palette.text.with-alpha(0.12);
    drop-shadow-color: #00000033; drop-shadow-blur: 14px; drop-shadow-offset-y: 4px;
    animate background { duration: 140ms; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Image {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: 16px; height: 16px; source: root.icon;
        colorize: Palette.text;
        transform-rotation: root.icon-rotation;
    }
    hit := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component SettingsCard inherits Rectangle {
    background: Palette.glass-sheen;
    drop-shadow-color: #0000002e; drop-shadow-blur: 28px; drop-shadow-offset-y: 10px;
    border-color: Palette.hairline;
    border-width: 1px;
    border-radius: 20px;
    VerticalLayout { padding: 20px; spacing: 10px; @children }
}

component RowInput inherits TouchArea {
    callback activate;
    callback primary-pressed;
    // Right-click position in window coordinates, for the app-level context menu.
    callback context-menu(length, length);
    pointer-event(event) => {
        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
            root.primary-pressed();
        }
        if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
            root.context-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
        }
    }
    clicked => { keyboard.focus(); root.activate(); }
    keyboard := FocusScope {
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(event) => {
            if root.enabled && (event.text == Key.Return || event.text == " ") {
                root.activate();
                return accept;
            }
            return reject;
        }
    }
    @children
}

export component Sonic inherits Window {
    icon: @image-url("../assets/icon.png");
    title: root.current-track < 0 || root.track-title == "—" ? "Sonic"
        : root.track-artist == "" || root.track-artist == "No track" ? root.track-title
        : root.track-artist + ": " + root.track-title;
    preferred-width: 1220px;
    preferred-height: 760px;
    min-width: 800px;
    min-height: 500px;
    background: Palette.background;
    default-font-family: ["Segoe UI", "Georgia", "Inter", "Courier New", "Trebuchet MS", "Palatino Linotype"][root.font-index];
    default-font-size: 14px;

    in property <[Album]> albums;
    in property <[SongHit]> song-hits;
    property <bool> searching;
    callback prefetch-album-tracks(string);
    callback play-search-hit(string, int);
    in property <[AlbumRow]> album-rows;
    in property <image> selected-art;
    in property <bool> local-enabled;
    in property <string> local-folder;
    in property <string> local-status;
    in property <int> local-count;
    callback start-local;
    callback open-local-folder;
    callback refresh-library;
    callback sort-albums(int);
    callback group-albums(int);
    callback album-action(string, int, int);
    callback track-action(int, int, int);
    callback queue-track-action(int, int, int);
    callback filter-local(bool);
    in property <[Track]> tracks;
    in property <[string]> playlists;
    in property <[PlaylistCard]> playlist-cards;
    in property <image> playlist-cover;
    in property <bool> playlist-has-art;
    callback choose-playlist-cover;
    in property <[QueueTrack]> playlist-items;
    in-out property <int> playlist-current: -1;
    in-out property <int> playlist-target: -1;
    in property <string> playlist-name;
    in property <string> theme-value: "#0f172a";
    in-out property <int> text-mode;
    in-out property <int> font-index;
    in property <[float]> eq-gains;
    in property <float> eq-preamp;
    in-out property <int> eq-preset-index;
    in property <string> eq-line;
    in property <string> eq-area;
    in property <bool> normalizer-enabled;
    callback toggle-normalizer;
    callback eq-band(int, float);
    callback eq-level(float);
    callback eq-preset(int);
    in-out property <bool> auto-art-theme;
    callback playlist-selected(int);
    callback playlist-queue-action(int, bool);
    callback create-playlist(string);
    callback rename-playlist(string);
    callback delete-playlist-at(int);
    callback add-to-playlist(int, int);
    callback play-playlist(int);
    callback remove-playlist-track(int);
    callback move-playlist-track(int, int);
    callback save-theme(string);
    callback pick-theme-color;
    in property <color> theme-swatch: #0f172a;
    callback refresh-theme;
    callback sign-out;
    callback reset-art;
    in-out property <string> discord-id;
    in-out property <string> discord-image;
    in property <string> discord-status;
    callback discord-test;
    in property <string> lastfm-status: "Disconnected";
    in property <bool> lastfm-pending;
    in property <bool> lastfm-connected;
    callback connect-lastfm(string, string);
    callback approve-lastfm;
    callback disconnect-lastfm;
    callback test-lastfm;

    in-out property <int> streaming-local: 2;
    in-out property <int> streaming-remote: 2;
    callback refresh-connection;
    in property <bool> refreshing-connection;
    in property <string> connection-status;
    in property <string> streaming-endpoint;
    in property <string> cache-status;
    in property <string> connection-type;
    in property <string> queue-duration;
    out property <int> dragged-track: -1;
    property <int> drop-track: -1;
    property <bool> editing-playlist;
    out property <int> playlist-drag: -1;
    property <int> playlist-drop: -1;
    in property <[QueueTrack]> queue;
    in property <[QueueLine]> queue-lines;
    pure callback queue-drop-index(int, float) -> int;
    in property <int> current-track: -1;
    in property <bool> shuffled;
    in property <int> repeat-mode;
    in property <float> volume-level: 80;
    in property <image> playing-art;
    in-out property <int> page;
    property <int> prior-page;
    property <int> settings-tab;
    property <bool> playlist-picker;
    property <string> playlist-album-key;
    property <int> playlist-track-index: -1;
    property <int> playlist-queue-index: -1;
    property <bool> playlist-search-hit;
    function choose-playlist(index: int) {
        if index >= 0 {
            if playlist-queue-index >= 0 {
                root.queue-track-action(playlist-queue-index, 3, index);
            } else if playlist-search-hit {
                root.search-hit-action(playlist-album-key, playlist-track-index, 3, index);
            } else if playlist-track-index >= 0 {
                root.track-action(playlist-track-index, 3, index);
            } else {
                root.album-action(playlist-album-key, 3, index);
            }
            playlist-picker = false;
        }
    }
    // App-level context menu. Kinds: 0 album, 1 selected-album track, 2 queue track,
    // 3 playlist card, 4 search hit. Choices: 0 add to queue, 1 shuffle play, 2 add to playlist / delete.
    property <bool> menu-open;
    property <length> menu-x;
    property <length> menu-y;
    property <int> menu-kind;
    property <string> menu-key;
    property <int> menu-index;
    function open-menu(kind: int, key: string, index: int, x: length, y: length) {
        menu-kind = kind;
        menu-key = key;
        menu-index = index;
        menu-x = x;
        menu-y = y;
        menu-open = true;
    }
    function menu-choose(choice: int) {
        menu-open = false;
        if menu-kind == 3 {
            if choice == 2 { root.delete-playlist-index = menu-index; }
            else { root.playlist-queue-action(menu-index, choice == 1); }
            return;
        }
        if choice == 2 {
            playlist-queue-index = menu-kind == 2 ? menu-index : -1;
            playlist-search-hit = menu-kind == 4;
            playlist-album-key = menu-key;
            playlist-track-index = menu-kind == 0 ? -1 : menu-index;
            playlist-picker = true;
            return;
        }
        if menu-kind == 0 { root.album-action(menu-key, choice + 1, -1); }
        else if menu-kind == 1 { root.track-action(menu-index, choice + 1, -1); }
        else if menu-kind == 2 { root.queue-track-action(menu-index, choice + 1, -1); }
        else if menu-kind == 4 { root.search-hit-action(menu-key, menu-index, choice + 1, -1); }
    }
    callback search-hit-action(string, int, int, int);
    in property <[QueueLine]> sidebar-lines;
    in property <[float]> viz-levels: [0, 0, 0, 0];
    in property <[LyricLine]> lyrics;
    in property <bool> lyrics-synced;
    in property <int> lyric-index: -1;
    in property <string> lyrics-status;
    in property <bool> lyrics-loading;
    in-out property <bool> online-lyrics: true;
    in-out property <bool> show-lyrics: true;
    callback lyrics-layout(int);
    callback toggle-online-lyrics;
    // Playlist pending deletion confirmation (-1 = none).
    property <int> delete-playlist-index: -1;
    property <bool> playlist-options;
    property <bool> renaming-playlist;
    in-out property <bool> creating-playlist;
    property <bool> sidebar-collapsed;
    callback close-album;
    in-out property <bool> list-mode;
    in-out property <bool> layout-locked;
    in-out property <length> sidebar-width: 260px;
    in-out property <length> track-panel-width: 245px;
    callback select-queue(int);
    callback move-queue(int, int);
    callback remove-queue(int);
    callback clear-queue;
    callback shuffle;
    callback repeat;
    callback mute;
    in property <string> selected-key;
    in property <string> album-title;
    in property <string> album-year;
    in property <string> album-artist;
    in property <bool> track-loading;
    in-out property <string> playback-error;
    in property <string> track-key;
    in property <string> track-title: "—";
    in property <string> track-artist: "No track";
    in property <string> status: "Connect Plex to browse your music.";
    in property <bool> connected;
    in property <bool> connecting;
    in property <bool> playing;
    in property <float> duration;
    in property <float> position;
    in property <string> elapsed: "0:00";
    in property <string> total: "0:00";
    callback sign-in;
    in property <bool> local-picker;
    callback open-files;
    callback search(string);
    callback select-album(string);
    callback select-track(int);
    callback prefetch-library-track(string, int);
    callback toggle-play;
    callback next-track;
    callback previous-track;
    callback seek(float);
    callback volume(float);

    callback request-visible-art(float, float, float, float, int);

    HorizontalLayout {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        spacing: 0px;
        if root.page != 1 || !root.sidebar-collapsed: Rectangle {
            width: root.sidebar-width;
            background: Palette.background;
            Rectangle {
                x: 12px; y: 12px; width: parent.width - 12px; height: parent.height - 22px;
                border-radius: 24px;
                background: Palette.glass-sheen;
                border-width: 1px; border-color: Palette.hairline;
                drop-shadow-color: #00000040; drop-shadow-blur: 30px; drop-shadow-offset-y: 8px;
            }
            VerticalLayout {
                x: 12px; y: 12px; width: parent.width - 12px; height: parent.height - 22px;
                padding: 16px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 6px;
                    property <length> size: (self.width - 18px) / 4;
                    height: self.size;
                    IconButton { width: parent.size; label: "Home"; icon: @image-url("icons/home.svg"); selected: root.page == 0; clicked => { root.page = 0; } }
                    IconButton { width: parent.size; label: "Queue"; icon: @image-url("icons/queue.svg"); selected: root.page == 2; clicked => { root.page = 2; } }
                    IconButton { width: parent.size; label: "Playlists"; icon: @image-url("icons/playlists.svg"); selected: root.page == 3; clicked => { root.page = 3; } }
                    IconButton { width: parent.size; label: "Settings"; icon: @image-url("icons/settings.svg"); selected: root.page == 4; clicked => { root.page = 4; } }
                }
                if root.selected-key != "": VerticalLayout {
                    spacing: 8px; padding-bottom: 12px;
                    Rectangle {
                        height: self.width;
                        background: Palette.background;
                        border-radius: 14px;
                        clip: true;
                        Artwork { width: parent.width; height: parent.height; source: root.selected-art; }
                        cover-hover := TouchArea { }
                        Rectangle {
                            x: parent.width - self.width - 8px; y: 8px; width: 26px; height: 26px;
                            border-radius: 13px;
                            background: close-album.has-hover ? Palette.glass-hover : Palette.surface.with-alpha(0.8);
                            border-width: 1px; border-color: Palette.hairline;
                            drop-shadow-color: #00000040; drop-shadow-blur: 8px; drop-shadow-offset-y: 2px;
                            opacity: cover-hover.has-hover || close-album.has-hover ? 1 : 0;
                            animate opacity { duration: 120ms; easing: ease-out; }
                            Image {
                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                width: 12px; height: 12px; source: @image-url("icons/close.svg"); colorize: Palette.text;
                            }
                            close-album := TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button; accessible-label: "Close album";
                                accessible-action-default => { root.close-album(); }
                                clicked => { root.close-album(); }
                            }
                        }
                    }
                    VerticalLayout {
                        Label { text: root.album-title; height: 17px; font-size: 13px; font-weight: 600; }
                        Label { text: root.album-artist == "" ? "—" : root.album-artist; height: 15px; font-size: 11px; opacity: 0.85; }
                    }
                    if root.tracks.length == 0: Label { text: "Loading…"; height: 16px; font-size: 12px; opacity: 0.8; }
                    ListView {
                        vertical-scrollbar-policy: always-off;
                        vertical-stretch: 1;
                        for track[index] in root.tracks: Rectangle {
                            height: 30px;
                            property <bool> current: root.track-key == track.key && root.track-key != "";
                            Rectangle {
                                y: 0px; height: 28px; width: parent.width - 4px;
                                border-radius: 9px;
                                clip: true;
                                accessible-role: button;
                                accessible-label: track.title;
                                accessible-action-default => { root.select-track(index); }
                                background: current ? Palette.selected : item.has-hover ? Palette.glass-hover : transparent;
                                if current: Rectangle { x: 0; y: 0; width: 3px; height: parent.height; background: Palette.text.with-alpha(0.45); }
                                item := RowInput {
                                    mouse-cursor: pointer;
                                    activate => { root.select-track(index); }
                                    primary-pressed => { root.prefetch-library-track("", index); }
                                    context-menu(x, y) => { root.open-menu(1, root.selected-key, index, x, y); }
                                    HorizontalLayout {
                                        padding-left: 11px; padding-right: 8px; spacing: 8px;
                                        Rectangle {
                                            width: 20px;
                                            if !current: Label { x: 0; text: (track.number > 0 ? track.number : index + 1) + ""; font-size: 12px; opacity: 0.7; }
                                            if current: NowPlayingMark { x: 0; width: 12px; height: 11px; levels: root.viz-levels; playing: root.playing; }
                                        }
                                        Label { text: track.title; horizontal-stretch: 1; font-size: 12px; font-weight: current ? 600 : 400; }
                                        Label { text: track.time; font-size: 12px; opacity: current ? 0.95 : 0.7; horizontal-alignment: right; }
                                    }
                                }
                                Timer {
                                    interval: 100ms; running: item.has-hover;
                                    triggered => { self.stop(); root.prefetch-library-track("", index); }
                                }
                            }
                        }
                    }
                }
                if root.selected-key == "" && (root.connected || root.local-count > 0 || root.queue.length > 0): VerticalLayout {
                    spacing: 12px;
                    Label { text: "QUEUE · " + max(0, root.queue.length - max(0, root.current-track)); font-size: 14px; font-weight: 600; height: 19px; opacity: 0.9; letter-spacing: 0.08px; }
                    ListView {
                        vertical-scrollbar-policy: always-off;
                        vertical-stretch: 1;
                        for line in root.sidebar-lines: Rectangle {
                            height: line.height * 1px;
                            property <bool> current: root.current-track == line.index;
                            if line.index < 0: HorizontalLayout {
                                y: 0px; height: 40px; spacing: 10px;
                                Rectangle {
                                    width: 40px; height: 40px; border-radius: 6px; clip: true; background: Palette.background;
                                    Artwork { width: parent.width; height: parent.height; source: line.track.art; }
                                }
                                Label { text: line.track.album == "" ? "—" : line.track.album; font-size: 14px; font-weight: 600; }
                            }
                            if line.index >= 0: Rectangle {
                                x: line.grouped ? 4px : 0px; y: 0px;
                                width: parent.width - self.x;
                                height: (line.height - line.gap) * 1px;
                                border-radius: 10px;
                                clip: true;
                                background: current ? Palette.selected : mini.has-hover ? Palette.glass-hover : transparent;
                                Rectangle { x: 0; width: 3px; background: Palette.text.with-alpha(0.45); visible: current; }
                                mini := RowInput {
                                    mouse-cursor: pointer;
                                    activate => { root.select-queue(line.index); }
                                    context-menu(x, y) => { root.open-menu(2, "", line.index, x, y); }
                                    HorizontalLayout {
                                        padding-left: line.grouped ? 14px : 11px; padding-right: line.grouped ? 10px : 8px;
                                        padding-top: line.grouped ? 0px : 4px; padding-bottom: line.grouped ? 0px : 4px;
                                        spacing: line.grouped ? 10px : 8px;
                                        if line.grouped: Rectangle {
                                            width: 20px;
                                            if !current: Label { text: line.number + ""; font-size: 13px; opacity: 0.7; }
                                            if current: NowPlayingMark { width: 14px; height: 13px; levels: root.viz-levels; playing: root.playing; }
                                        }
                                        if line.grouped: Label { text: line.track.title; horizontal-stretch: 1; font-size: 14px; font-weight: current ? 600 : 400; }
                                        if !line.grouped: Rectangle {
                                            width: 36px; height: 36px; border-radius: 6px; clip: true; background: Palette.background;
                                            Artwork { width: parent.width; height: parent.height; source: line.track.art; }
                                            if current: Rectangle {
                                                background: #00000080;
                                                NowPlayingMark { width: 14px; height: 13px; levels: root.viz-levels; playing: root.playing; ink: #ffffff; }
                                            }
                                        }
                                        if !line.grouped: VerticalLayout {
                                            horizontal-stretch: 1; alignment: center; spacing: 1px;
                                            Label { text: line.track.title; height: 17px; font-size: 13px; font-weight: current ? 600 : 500; }
                                            Label { text: line.track.artist == "" ? "—" : line.track.artist; height: 14px; font-size: 11px; opacity: 0.8; }
                                        }
                                        Rectangle {
                                            width: line.grouped ? 24px : 20px;
                                            Text {
                                                text: "×"; font-size: line.grouped ? 16px : 14px; color: Palette.muted;
                                                horizontal-alignment: center; vertical-alignment: center;
                                                visible: mini.has-hover;
                                            }
                                            TouchArea {
                                                enabled: mini.has-hover;
                                                mouse-cursor: pointer;
                                                accessible-role: button; accessible-label: "Remove from queue";
                                                accessible-action-default => { root.remove-queue(line.index); }
                                                clicked => { root.remove-queue(line.index); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if root.selected-key == "" && !root.connected && root.local-count == 0 && root.queue.length == 0: Rectangle { vertical-stretch: 1; }
            }
            if !root.layout-locked: Rectangle {
                x: parent.width - 8px;
                width: 8px;
                background: transparent;
                TouchArea {
                    mouse-cursor: col-resize;
                    moved => { if self.pressed { root.sidebar-width = clamp(root.sidebar-width + self.mouse-x - self.pressed-x, 200px, 420px); } }
                }
            }
        }
        VerticalLayout {
            width: root.width - (root.page != 1 || !root.sidebar-collapsed ? root.sidebar-width : 0px);
            spacing: 0px;
            HorizontalLayout {
                vertical-stretch: 1;
                if root.page == 0 && !root.connected && !root.local-enabled: Rectangle {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        x: 24px; y: 40px;
                        width: min(420px, parent.width - 48px);
                        spacing: 12px;
                        alignment: start;
                        Rectangle {
                            height: 110px;
                            border-width: 1px; border-color: Palette.hairline; border-radius: 20px; background: Palette.glass-sheen;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 8px;
                                Label { text: "No music source connected"; height: 22px; font-size: 18px; font-weight: 600; }
                                Text { text: "Go to Settings to connect Plex or turn on local files to browse and play music here."; wrap: word-wrap; color: Palette.text; font-size: 13px; }
                            }
                        }
                        Action { width: 121px; height: 38px; label: "Open Settings"; active: true; clicked => { root.page = 4; } }
                    }
                }
            if root.page == 0 && (root.connected || root.local-enabled): VerticalLayout {
                horizontal-stretch: 1;
                padding: 24px; padding-top: 40px; padding-bottom: 16px;
                spacing: 16px;
                library-controls := Rectangle {
                    min-width: 0px;
                    property <bool> stacked: self.width < (root.local-count > 0 ? 730px : 620px);
                    height: self.stacked ? 81px : 35px;
                    HorizontalLayout {
                        x: 0px; y: 0px;
                        width: library-controls.stacked ? parent.width : parent.width - sort-controls.width - 12px;
                        height: 35px; spacing: 12px;
                        LineEdit {
                            min-width: 0px; max-width: 400px; horizontal-stretch: 1; field-color: Palette.surface;
                            placeholder-text: "Search songs and albums…";
                            edited(text) => { root.searching = text != ""; grid.content-y = 0px; root.search(text); }
                        }
                        if root.local-count > 0: ComboBox { field-color: Palette.surface; width: 104px; model: ["All music", "Local files"]; selected => { root.filter-local(self.current-index == 1); } }
                        Rectangle { width: 100px; Action { width: 100px; height: 28px; font-size: 13px; label: "Refresh library"; clicked => { root.refresh-library(); } } }
                    }
                    sort-controls := HorizontalLayout {
                        x: library-controls.stacked ? 0px : parent.width - self.width;
                        y: library-controls.stacked ? 46px : 0px;
                        width: 380px; height: 35px; spacing: 7px;
                        Label { width: 38px; text: "Sort by"; font-size: 12px; }
                        Rectangle { width: 116px; ComboBox { field-color: Palette.surface;
                            width: 116px; height: 29px; current-index: 2;
                            model: ["Title (A–Z)", "Title (Z–A)", "Artist (A–Z)", "Artist (Z–A)", "Year (newest)", "Year (oldest)"];
                            selected => { grid.content-y = 0px; root.sort-albums(self.current-index); }
                        } }
                        Label { width: 51px; text: "Group by"; font-size: 12px; }
                        Rectangle { width: 72px; ComboBox { field-color: Palette.surface; width: 72px; height: 29px; model: ["None", "Artist", "Year"]; selected => { grid.content-y = 0px; root.group-albums(self.current-index); } } }
                        Rectangle { width: 35px; IconButton { width: 35px; height: 31px; outlined: true; label: "Grid view"; icon: @image-url("icons/grid.svg"); selected: !root.list-mode; clicked => { root.list-mode = false; grid.content-y = 0px; } } }
                        Rectangle { width: 30px; IconButton { width: 30px; height: 31px; outlined: true; label: "List view"; icon: @image-url("icons/queue.svg"); selected: root.list-mode; clicked => { root.list-mode = true; grid.content-y = 0px; } } }
                    }
                }
                if root.albums.length == 0: Label {
                    text: root.local-enabled ? root.local-status : "No albums found.";
                    color: Palette.muted;
                    height: 22px;
                }
                HorizontalLayout {
                    spacing: 24px;
                    if root.searching: VerticalLayout {
                        horizontal-stretch: 1; spacing: 12px;
                        Label { text: "SONGS"; font-size: 11px; font-weight: 600; height: 17px; color: Palette.muted; }
                        ListView {
                            vertical-scrollbar-policy: always-off;
                            for hit in root.song-hits: Rectangle {
                                height: 64px;
                                Rectangle {
                                    height: 60px; border-radius: 14px; background: Palette.glass; border-width: 1px; border-color: Palette.hairline;
                                    HorizontalLayout {
                                        padding-left: 12px; padding-right: 12px; padding-top: 10px; padding-bottom: 10px; spacing: 12px;
                                        Rectangle {
                                            width: 40px; height: 40px; border-radius: 6px; clip: true; background: Palette.background;
                                            Artwork { width: parent.width; height: parent.height; source: hit.art; }
                                        }
                                        Label { text: hit.number + ""; width: 20px; font-size: 12px; color: Palette.muted; }
                                        VerticalLayout {
                                            horizontal-stretch: 1; alignment: center; spacing: 2px;
                                            Label { text: hit.title; height: 18px; font-weight: 500; }
                                            Label { text: hit.description; height: 15px; font-size: 12px; color: Palette.muted; }
                                        }
                                        Label { text: hit.time; width: 32px; font-size: 12px; color: Palette.muted; }
                                    }
                                    song := RowInput {
                                        mouse-cursor: pointer;
                                        activate => { root.play-search-hit(hit.album-key, hit.track-index); }
                                        primary-pressed => { root.prefetch-library-track(hit.album-key, hit.track-index); }
                                        context-menu(x, y) => { root.open-menu(4, hit.album-key, hit.track-index, x, y); }
                                    }
                                    Timer {
                                        interval: 100ms; running: song.has-hover;
                                        triggered => { self.stop(); root.prefetch-library-track(hit.album-key, hit.track-index); }
                                    }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1; spacing: 12px;
                        if root.searching: Label { text: "ALBUMS"; font-size: 11px; font-weight: 600; height: 17px; color: Palette.muted; }
                grid := ListView {
                    vertical-scrollbar-policy: always-off;
                    horizontal-stretch: 1;
                    min-width: 0px;
                    property <length> gap: 16px;
                    property <int> columns: root.list-mode ? 1 : max(1, floor((self.visible-width + self.gap) / (160px + self.gap)));
                    property <length> cover-size: max(1px, (self.visible-width - (self.columns - 1) * self.gap) / self.columns);
                    property <length> row-height: root.list-mode ? 68px : self.cover-size + 59px;
                    property <length> year-height: 0px;
                    for row in root.album-rows: Rectangle {
                      height: self.cards-height + (row.heading == "" ? 0px : 27px);
                      property <length> cards-height: grid.row-height + (row.has-year ? grid.year-height : 0px);
                      if row.heading != "": Label { x: 0px; y: 0px; height: 23px; text: row.heading; font-size: 11px; font-weight: 600; color: Palette.muted; }
                      for column in row.count: Rectangle {
                        property <Album> album: root.albums[row.offset + column];
                        x: column * (grid.cover-size + grid.gap);
                        y: row.heading == "" ? 0px : 27px;
                        width: grid.cover-size;
                        height: parent.cards-height - (root.list-mode ? 4px : grid.gap);
                        border-radius: 14px;
                        background: root.list-mode ? (root.selected-key == album.key ? Palette.selected : tile.has-hover ? Palette.hover : Palette.surface) : transparent;
                        if !root.list-mode: VerticalLayout {
                            Rectangle {
                                height: grid.cover-size;
                                background: root.selected-key == album.key ? Palette.selected : Palette.surface;
                                border-radius: 14px;
                                drop-shadow-color: #00000038; drop-shadow-blur: 18px; drop-shadow-offset-y: 6px;
                                clip: true;
                                Artwork { width: parent.width; height: parent.height; source: album.art; }
                                // Selection ring drawn inside the cover so the grid edges never clip it.
                                if root.selected-key == album.key: Rectangle {
                                    border-radius: 14px; border-width: 2px; border-color: Palette.text.with-alpha(0.55);
                                }
                            }
                            VerticalLayout {
                                padding-top: 8px; padding-left: 2px; padding-right: 2px; spacing: 2px;
                                Label { text: album.title; font-weight: 600; font-size: 13px; height: 17px; }
                                Label { text: album.artist == "" ? "—" : album.artist; opacity: 0.8; font-size: 12px; height: 16px; }
                            }
                        }
                        if root.list-mode: HorizontalLayout {
                            padding-left: 12px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px;
                            spacing: 12px;
                            Rectangle {
                                width: 48px; border-radius: 6px; clip: true; background: Palette.background;
                                Artwork { width: parent.width; height: parent.height; source: album.art; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1; alignment: center; spacing: 2px;
                                Label { text: album.title; height: 17px; font-weight: 600; }
                                Label { text: album.artist == "" ? "—" : album.artist; height: 15px; font-size: 12px; color: Palette.muted; }
                            }
                        }
                        accessible-role: button;
                        accessible-label: album.title;
                        accessible-action-default => { root.select-album(album.key); }
                        tile := RowInput {
                            x: 0; y: 0; width: parent.width; height: parent.height;
                            mouse-cursor: pointer;
                            activate => { root.select-album(album.key); }
                            double-clicked => { root.album-action(album.key, 0, -1); }
                            context-menu(x, y) => { root.open-menu(0, album.key, -1, x, y); }
                        }
                        Timer {
                            interval: 200ms;
                            running: tile.has-hover;
                            triggered => { self.stop(); root.prefetch-album-tracks(album.key); }
                        }
                      }
                    }
                }
                    }
                }
                Timer {
                    interval: 180ms;
                    running: root.connected || root.local-enabled;
                    triggered => { root.request-visible-art(-grid.content-y / 1px, grid.visible-height / 1px, grid.row-height / 1px, grid.year-height / 1px, grid.columns); }
                }
            }
            if root.page == 1: now-playing := Rectangle {
                horizontal-stretch: 1;
                property <bool> has-lyrics: root.lyrics.length > 0;
                property <bool> want-lyrics: root.show-lyrics && root.current-track >= 0;
                // Stay in the lyrics layout while the next song's lyrics load, so skipping
                // doesn't bounce the cover between layouts.
                property <bool> lyrics-mode: self.want-lyrics && (self.has-lyrics || root.lyrics-loading);
                property <bool> split: self.lyrics-mode && self.width >= 860px;
                property <bool> lyrics-only: self.lyrics-mode && !self.split;
                property <length> area-height: self.height - 56px;
                // Room under the cover (or lyrics) for the track title and artist.
                property <length> info-height: 64px;
                property <length> cover-size: self.split
                    ? max(0px, min(420px, self.width * 0.42 - 72px, self.area-height - 64px - self.info-height))
                    : max(0px, min(480px, self.width - 112px, self.height - 120px - self.info-height));
                property <length> cover-x: self.split ? 48px + (self.width * 0.42 - 48px - self.cover-size) / 2 : (self.width - self.cover-size) / 2;
                property <length> cover-y: 40px + (self.area-height - self.cover-size - self.info-height) / 2;
                if root.current-track >= 0 && !now-playing.lyrics-only: Rectangle {
                    x: now-playing.cover-x; y: now-playing.cover-y;
                    width: now-playing.cover-size; height: now-playing.cover-size;
                    background: Palette.surface; border-radius: 14px;
                    drop-shadow-color: #00000080; drop-shadow-blur: 48px; drop-shadow-offset-y: 24px;
                    animate x, y, width, height { duration: 250ms; easing: ease-out; }
                    Rectangle {
                        border-radius: 14px; clip: true;
                        Artwork { width: parent.width; height: parent.height; source: root.playing-art; }
                    }
                    Rectangle { border-radius: 14px; border-width: 1px; border-color: #ffffff1a; }
                }
                if root.current-track >= 0: VerticalLayout {
                    x: now-playing.lyrics-only ? 48px : now-playing.cover-x;
                    width: now-playing.lyrics-only ? now-playing.width - 96px : now-playing.cover-size;
                    y: (now-playing.lyrics-only ? lyrics-panel-bottom : now-playing.cover-y + now-playing.cover-size) + 16px;
                    height: 48px; spacing: 2px;
                    property <length> lyrics-panel-bottom: 40px + (now-playing.area-height - now-playing.info-height + min(420px, now-playing.area-height - 64px - now-playing.info-height)) / 2;
                    Label { text: root.track-title; height: 26px; font-size: 20px; font-weight: 700; }
                    Label { text: root.track-artist; height: 20px; font-size: 15px; color: Palette.muted; }
                }
                if now-playing.want-lyrics && !now-playing.lyrics-mode && root.lyrics-status != "": Label {
                    y: now-playing.cover-y + now-playing.cover-size + 70px; height: 20px; width: parent.width;
                    horizontal-alignment: center; text: root.lyrics-status; font-size: 13px; color: Palette.muted;
                }
                if now-playing.split || now-playing.lyrics-only: lyrics-panel := Rectangle {
                    // Same top and bottom as the cover beside it.
                    x: now-playing.split ? now-playing.width * 0.42 + 24px : 48px;
                    width: now-playing.split ? now-playing.width * 0.58 - 72px : now-playing.width - 96px;
                    height: now-playing.split ? now-playing.cover-size : max(0px, min(420px, now-playing.area-height - 64px - now-playing.info-height));
                    y: now-playing.split ? now-playing.cover-y : 40px + (now-playing.area-height - now-playing.info-height - self.height) / 2;
                    clip: true;
                    property <int> wrap-chars: floor(self.width / 19px);
                    init => { root.lyrics-layout(self.wrap-chars); }
                    changed wrap-chars => { root.lyrics-layout(self.wrap-chars); }
                    property <length> total: root.lyrics.length > 0
                        ? (root.lyrics[root.lyrics.length - 1].y + root.lyrics[root.lyrics.length - 1].height) * 1px : 0px;
                    // Before the first line starts, the first line waits in the middle.
                    property <int> focus-row: max(0, root.lyric-index);
                    property <length> focus-y: root.lyrics.length > 0
                        ? (root.lyrics[self.focus-row].y + root.lyrics[self.focus-row].height / 2) * 1px : 0px;
                    // Lines fade out toward the panel's top and bottom edges.
                    pure function fade(center: length) -> float {
                        return clamp(1 - (abs(center - self.height / 2) - self.height * 0.16) / (self.height * 0.3), 0, 1);
                    }
                    if root.lyrics-synced: synced := Rectangle {
                        y: lyrics-panel.height * 0.5 - lyrics-panel.focus-y;
                        width: lyrics-panel.width; height: lyrics-panel.total;
                        animate y { duration: 420ms; easing: ease-out; }
                        for line[index] in root.lyrics: LyricRow {
                            y: line.y * 1px; height: line.height * 1px; width: lyrics-panel.width;
                            line: line; state: index == root.lyric-index ? 0 : index < root.lyric-index ? -1 : 1;
                            fade: lyrics-panel.fade(synced.y + (line.y + line.height / 2) * 1px);
                            jump => { if line.time >= 0 { root.seek(line.time); } }
                        }
                    }
                    if !root.lyrics-synced: plain := Flickable {
                        content-height: lyrics-panel.total + lyrics-panel.height;
                        for line in root.lyrics: LyricRow {
                            y: line.y * 1px + lyrics-panel.height / 2 - 22px; height: line.height * 1px; width: lyrics-panel.width;
                            line: line; state: 0;
                            fade: lyrics-panel.fade(plain.content-y + self.y + self.height / 2);
                        }
                    }
                }
                if root.current-track < 0: VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    Label { height: 56px; text: "♪"; horizontal-alignment: center; font-size: 48px; color: Palette.muted; opacity: 0.3; }
                    Label { height: 25px; text: "Nothing playing. Pick something from Music or the Queue."; horizontal-alignment: center; color: Palette.muted; font-size: 15px; }
                }
                GlassButton {
                    x: 36px; y: 52px; width: 36px; height: 36px;
                    label: root.sidebar-collapsed ? "Show sidebar" : "Hide sidebar";
                    icon: @image-url("icons/chevron-left.svg");
                    icon-rotation: root.sidebar-collapsed ? 180deg : 0deg;
                    clicked => { root.sidebar-collapsed = !root.sidebar-collapsed; }
                }
                if root.current-track >= 0: GlassButton {
                    x: parent.width - self.width - 36px; y: 52px; width: 36px; height: 36px;
                    label: root.show-lyrics ? "Hide lyrics" : "Show lyrics";
                    icon: @image-url("icons/mic.svg");
                    active: root.show-lyrics;
                    clicked => { root.show-lyrics = !root.show-lyrics; }
                }
            }
            if root.page == 2: Rectangle {
                horizontal-stretch: 1;
                VerticalLayout {
                    x: 24px; y: 40px;
                    width: min(776px, parent.width - 48px);
                    height: parent.height - 56px;
                    spacing: 21px;
                    if root.queue.length > 0: HorizontalLayout {
                        height: 35px; spacing: 14px;
                        Label {
                            text: "NOW & UP NEXT · " + (root.queue.length - max(0, root.current-track)) + ((root.queue.length - max(0, root.current-track)) == 1 ? " TRACK · " : " TRACKS · ") + root.queue-duration;
                            font-size: 15px; font-weight: 600; color: Palette.muted; letter-spacing: 0.06px; horizontal-stretch: 1;
                        }
                        Action { width: 105px; height: 35px; muted-label: true; font-size: 13px; label: "Clear queue"; clicked => { root.clear-queue(); } }
                    }
                    if root.queue.length == 0: VerticalLayout {
                        alignment: start; padding-top: 76px; spacing: 14px;
                        Label { text: "♪"; height: 64px; horizontal-alignment: center; font-size: 55px; color: Palette.text; opacity: 0.3; }
                        Label { text: root.connected || root.local-enabled ? "Queue is empty. Add tracks from Music." : "Sign in to Plex or enable local files in Settings to add and see your queue.";
                            height: 32px; horizontal-alignment: center; font-size: 15px; color: Palette.muted; }
                    }
                    if root.queue.length == 0: Rectangle { vertical-stretch: 1; }
                    if root.queue.length > 0: ListView {
                        vertical-scrollbar-policy: always-off;
                        vertical-stretch: 1;
                        for line in root.queue-lines: Rectangle {
                            height: line.height * 1px;
                            property <bool> current: root.current-track == line.index;
                            if line.index < 0: HorizontalLayout {
                                y: 0px; height: 48px; spacing: 12px;
                                Rectangle {
                                    width: 48px; height: 48px; border-radius: 7px; clip: true; background: Palette.surface;
                                    Artwork { width: parent.width; height: parent.height; source: line.track.art; }
                                }
                                VerticalLayout {
                                    alignment: center; spacing: 0px;
                                    Label { text: line.track.album == "" ? "—" : line.track.album; font-size: 15px; font-weight: 600; height: 20px; }
                                    Label { text: line.track.artist == "" ? "—" : line.track.artist; font-size: 13px; opacity: 0.8; height: 17px; }
                                }
                            }
                            if line.index >= 0: Rectangle {
                                y: 0px; width: parent.width;
                                height: (line.height - line.gap) * 1px;
                                border-radius: line.grouped ? 12px : 10px;
                                clip: true;
                                background: current ? Palette.selected : line.grouped ? Palette.glass : transparent;
                                opacity: root.dragged-track == line.index ? 0.6 : 1;
                                Rectangle { x: 0px; width: 3px; background: Palette.text.with-alpha(0.45); visible: current; }
                                Rectangle { x: 0px; y: 0px; height: 2px; border-radius: 1px; background: Palette.accent-ink; visible: root.drop-track == line.index && root.dragged-track != line.index; }
                                row-input := RowInput {
                                    mouse-cursor: pointer;
                                    activate => { root.select-queue(line.index); }
                                    context-menu(x, y) => { root.open-menu(2, "", line.index, x, y); }
                                    HorizontalLayout {
                                        padding-left: line.grouped ? 13px : 3px; padding-right: line.grouped ? 10px : 0px; spacing: 8px;
                                        padding-top: line.grouped ? 0px : 7px; padding-bottom: line.grouped ? 0px : 7px;
                                        if !line.grouped: Rectangle {
                                            width: 38px; height: 38px; border-radius: 6px; clip: true; background: Palette.surface;
                                            Artwork { width: parent.width; height: parent.height; source: line.track.art; }
                                        }
                                        if line.grouped: ReorderGrip {
                                            show-handle: row-input.has-hover;
                                            index: line.index; first: max(0, root.current-track); last: root.queue.length - 1;
                                            row-height: line.height * 1px; uneven-rows: true;
                                            map-distance(distance) => { return root.queue-drop-index(line.index, distance); }
                                            target(row) => { root.dragged-track = row < 0 ? -1 : line.index; root.drop-track = row; }
                                            reorder(delta) => { root.move-queue(line.index, delta); }
                                        }
                                        if line.grouped: Rectangle {
                                            width: 18px;
                                            if !(current && root.playing): Label { x: 0; text: line.number + ""; font-size: 12px; opacity: current ? 1 : 0.7; }
                                            if current && root.playing: NowPlayingMark { x: 0; width: 12px; height: 11px; levels: root.viz-levels; playing: true; }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1; alignment: center; spacing: 1px;
                                            Label { text: line.track.title; height: 19px; font-size: 14px; font-weight: current ? 600 : 500; }
                                            if !line.grouped: Label { text: line.track.artist == "" ? "—" : line.track.artist; height: 16px; font-size: 12px; opacity: 0.8; }
                                        }
                                        Rectangle {
                                            width: line.grouped ? 30px : 22px;
                                            if line.grouped && !row-input.has-hover: Label {
                                                text: line.track.time; font-size: 12px; opacity: 0.8;
                                                horizontal-alignment: right;
                                            }
                                            if row-input.has-hover: Rectangle {
                                                x: parent.width - 22px; width: 22px; height: 22px;
                                                border-radius: 8px;
                                                background: remove.has-hover ? Palette.hover : transparent;
                                                Text { text: "×"; font-size: line.grouped ? 14px : 15px; color: Palette.muted; horizontal-alignment: center; vertical-alignment: center; }
                                                remove := TouchArea {
                                                    mouse-cursor: pointer;
                                                    accessible-role: button; accessible-label: "Remove from queue";
                                                    accessible-action-default => { root.remove-queue(line.index); }
                                                    clicked => { root.remove-queue(line.index); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if root.page == 3 && root.playlist-current < 0: Rectangle {
                horizontal-stretch: 1;
                VerticalLayout {
                    x: 24px; y: 40px; width: parent.width - 48px; height: parent.height - 56px;
                    spacing: 21px;
                    HorizontalLayout {
                        spacing: 10px; alignment: start; height: 34px;
                        Label { text: "Playlists"; font-size: 24px; font-weight: 700; }
                        Action { width: 34px; height: 34px; label: "+"; font-size: 18px; accessible-label: "New playlist"; clicked => { root.creating-playlist = true; } }
                    }
                    if root.creating-playlist: HorizontalLayout {
                        spacing: 7px; alignment: start; height: 39px;
                        new-name := LineEdit {
                            width: 254px; height: 39px; placeholder-text: "Playlist name"; field-color: Palette.background;
                            init => { self.grab-focus(); }
                            accepted => { root.create-playlist(self.text == "" ? "New Playlist" : self.text); root.playlist-selected(root.playlist-target); }
                            cancelled => { root.creating-playlist = false; }
                        }
                        Action { width: 79px; height: 39px; label: "Create"; active: true; clicked => {
                            root.create-playlist(new-name.text == "" ? "New Playlist" : new-name.text);
                            root.playlist-selected(root.playlist-target);
                        } }
                        Action { width: 80px; height: 39px; label: "Cancel"; clicked => { root.creating-playlist = false; } }
                    }
                    if root.playlist-cards.length > 0: cards := ListView {
                        vertical-scrollbar-policy: always-off;
                        vertical-stretch: 1;
                        property <length> gap: 21px;
                        property <int> columns: max(1, floor((self.visible-width + self.gap) / (173px + self.gap)));
                        property <length> card-width: (self.visible-width - (self.columns - 1) * self.gap) / self.columns;
                        for row in ceil(root.playlist-cards.length / (self.columns * 1.0)): Rectangle {
                            height: cards.card-width + 43px + cards.gap;
                            for column in min(cards.columns, root.playlist-cards.length - row * cards.columns): Rectangle {
                                property <int> index: row * cards.columns + column;
                                property <PlaylistCard> card: root.playlist-cards[index];
                                x: column * (cards.card-width + cards.gap);
                                width: cards.card-width;
                                height: parent.height - cards.gap;
                                accessible-role: button;
                                accessible-label: card.name;
                                accessible-action-default => { root.editing-playlist = false; root.playlist-selected(index); }
                                VerticalLayout {
                                    Rectangle {
                                        border-radius: 14px; background: Palette.surface; height: parent.width; clip: true;
                                        if card.has-art: Artwork { width: parent.width; height: parent.height; source: card.artwork; }
                                        if !card.has-art: Label { text: "♪"; font-size: 48px; horizontal-alignment: center; opacity: 0.4; }
                                    }
                                    VerticalLayout {
                                        padding-top: 10px; padding-left: 2px; padding-right: 2px; spacing: 4px;
                                        Label { text: card.name; font-size: 14px; font-weight: 600; height: 18px; }
                                        Label { text: card.count + (card.count == 1 ? " track" : " tracks"); font-size: 11px; opacity: 0.8; height: 14px; }
                                    }
                                }
                                RowInput {
                                    mouse-cursor: pointer;
                                    activate => { root.editing-playlist = false; root.playlist-selected(index); }
                                    double-clicked => { if card.count > 0 { root.playlist-selected(index); root.play-playlist(0); } }
                                    context-menu(x, y) => { root.open-menu(3, "", index, x, y); }
                                }
                            }
                        }
                    }
                    if root.playlist-cards.length == 0: Label { text: "Create a playlist to get started."; height: 20px; color: Palette.muted; }
                    if root.playlist-cards.length == 0: Rectangle { vertical-stretch: 1; }
                }
            }
            if root.page == 3 && root.playlist-current >= 0: Rectangle {
                horizontal-stretch: 1;
                VerticalLayout {
                    x: 24px; y: 40px; width: parent.width - 48px; height: parent.height - 40px;
                    spacing: 10px;
                    HorizontalLayout {
                        height: 35px;
                        Action { width: 74px; height: 35px; font-size: 13px; label: "← Back"; clicked => {
                            root.playlist-selected(-1); root.editing-playlist = false; root.renaming-playlist = false; root.playlist-options = false;
                        } }
                        Rectangle { horizontal-stretch: 1; }
                        Action {
                            width: 34px; height: 35px; label: ""; accessible-label: "Playlist options";
                            clicked => { root.playlist-options = !root.playlist-options; }
                            for dot in 3: Rectangle {
                                x: (parent.width - 3px) / 2; y: parent.height / 2 - 6.5px + dot * 5px;
                                width: 3px; height: 3px; border-radius: 1.5px; background: Palette.text;
                            }
                        }
                    }
                    ListView {
                        vertical-scrollbar-policy: always-off;
                        vertical-stretch: 1;
                        for item in root.playlist-items.length + 1: Rectangle {
                            property <int> track-index: item - 1;
                            height: item == 0 ? 224px + (root.playlist-items.length == 0 ? 98px : 0px) : 62px;
                            if item == 0: VerticalLayout {
                                y: 0px; height: parent.height;
                                spacing: 18px;
                                HorizontalLayout {
                                    height: 206px; spacing: 20px;
                                    Rectangle {
                                        width: 206px; height: 206px; border-radius: 14px; background: Palette.surface; clip: true;
                                        if root.playlist-has-art: Artwork { width: parent.width; height: parent.height; source: root.playlist-cover; }
                                        if !root.playlist-has-art && root.editing-playlist: Label { text: "Add cover"; font-size: 15px; color: Palette.muted; horizontal-alignment: center; }
                                        if root.editing-playlist: TouchArea {
                                            mouse-cursor: pointer;
                                            accessible-role: button; accessible-label: "Change cover";
                                            accessible-action-default => { root.choose-playlist-cover(); }
                                            clicked => { root.choose-playlist-cover(); }
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1; alignment: start; spacing: 7px;
                                        if !root.renaming-playlist: Label {
                                            text: root.playlist-name; font-size: 31px; font-weight: 700; height: 38px; letter-spacing: -0.6px;
                                            TouchArea { mouse-cursor: pointer; clicked => { root.renaming-playlist = true; } }
                                        }
                                        if root.renaming-playlist: rename := LineEdit {
                                            text: root.playlist-name; height: 53px; max-width: 345px; field-color: Palette.background;
                                            font-size: 24px; font-weight: 700; border-width: 2px;
                                            init => { self.grab-focus(); self.select-all(); }
                                            accepted => { root.rename-playlist(self.text); root.renaming-playlist = false; }
                                            cancelled => { root.renaming-playlist = false; }
                                            focus-lost => { root.rename-playlist(self.text); root.renaming-playlist = false; }
                                        }
                                        Label { text: root.playlist-items.length + (root.playlist-items.length == 1 ? " track" : " tracks"); font-size: 14px; color: Palette.muted; height: 19px; }
                                        // Wrapped so the fixed-size button does not cap the column width.
                                        if root.playlist-items.length > 0: HorizontalLayout {
                                            alignment: start;
                                            Rectangle {
                                                width: 48px; height: 48px; border-radius: 24px;
                                                background: play-all.has-hover ? Palette.accent.brighter(0.1) : Palette.accent;
                                                accessible-role: button; accessible-label: "Play playlist";
                                                accessible-action-default => { root.play-playlist(0); }
                                                Image {
                                                    x: (parent.width - self.width) / 2 + 2px; y: (parent.height - self.height) / 2;
                                                    width: 20px; height: 20px; source: @image-url("icons/play.svg"); colorize: Palette.accent-text;
                                                }
                                                play-all := TouchArea { mouse-cursor: pointer; clicked => { root.play-playlist(0); } }
                                            }
                                        }
                                    }
                                }
                                if root.playlist-items.length == 0: VerticalLayout {
                                    spacing: 10px; alignment: start;
                                    HorizontalLayout {
                                        alignment: start;
                                        Action { width: 100px; height: 37px; label: "Add music"; clicked => { root.playlist-selected(-1); root.page = 0; } }
                                    }
                                    Text { text: "No tracks. Click “Add music” to go to Music, then right‑click tracks or albums to add to this playlist."; wrap: word-wrap; font-size: 13px; color: Palette.muted; }
                                }
                            }
                            if item > 0: Rectangle {
                                y: 0px; height: 57px;
                                border-radius: 12px;
                                opacity: root.playlist-drag == track-index ? 0.6 : 1;
                                background: Palette.glass; border-width: 1px; border-color: Palette.hairline;
                                Rectangle { x: 0px; y: 0px; height: 2px; border-radius: 1px; background: Palette.accent-ink; visible: root.playlist-drop == track-index && root.playlist-drag != track-index; }
                                RowInput {
                                    enabled: !root.editing-playlist;
                                    mouse-cursor: root.editing-playlist ? default : pointer;
                                    activate => { root.play-playlist(track-index); }
                                    HorizontalLayout {
                                        padding-left: 14px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px; spacing: 10px;
                                        if root.editing-playlist: ReorderGrip {
                                            width: 22px;
                                            index: track-index;
                                            first: 0;
                                            last: root.playlist-items.length - 1;
                                            row-height: 62px;
                                            target(row) => { root.playlist-drag = row < 0 ? -1 : track-index; root.playlist-drop = row; }
                                            reorder(delta) => { root.move-playlist-track(track-index, delta); }
                                        }
                                        Rectangle {
                                            width: 41px; height: 41px; border-radius: 6px; clip: true; background: Palette.background;
                                            Artwork { width: parent.width; height: parent.height; source: root.playlist-items[track-index].art; }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1; alignment: center; spacing: 1px;
                                            Label { text: root.playlist-items[track-index].title; font-size: 13px; font-weight: 600; height: 18px; }
                                            Label { text: root.playlist-items[track-index].artist + " · " + root.playlist-items[track-index].album; font-size: 11px; opacity: 0.8; height: 15px; }
                                        }
                                        if root.editing-playlist: Rectangle { width: 24px; Rectangle {
                                            width: 24px; height: 24px; border-radius: 8px; border-width: 1px; border-color: Palette.hairline;
                                            background: remove-track.has-hover ? Palette.hover : Palette.background;
                                            Text { text: "×"; font-size: 16px; color: Palette.muted; horizontal-alignment: center; vertical-alignment: center; }
                                            remove-track := TouchArea {
                                                mouse-cursor: pointer;
                                                accessible-role: button; accessible-label: "Remove from playlist";
                                                accessible-action-default => { root.remove-playlist-track(track-index); }
                                                clicked => { root.remove-playlist-track(track-index); }
                                            }
                                        } }
                                    }
                                }
                            }
                        }
                    }
                }
                if root.playlist-options: TouchArea {
                    clicked => { root.playlist-options = false; }
                }
                if root.playlist-options: Rectangle {
                    width: 157px; height: 92px;
                    x: parent.width - 24px - self.width; y: 40px + 35px + 6px;
                    border-radius: 14px; border-width: 1px; border-color: Palette.hairline; background: Palette.surface;
                    drop-shadow-color: #00000055; drop-shadow-blur: 28px; drop-shadow-offset-y: 10px;
                    TouchArea { }
                    VerticalLayout {
                        padding: 7px;
                        for label[choice] in [root.editing-playlist ? "Done editing" : "Edit playlist", "Delete"]: Rectangle {
                            height: 38px; border-radius: 9px;
                            background: opt-hit.has-hover ? Palette.hover : transparent;
                            accessible-role: button; accessible-label: label;
                            accessible-action-default => {
                                root.playlist-options = false;
                                if choice == 0 { root.editing-playlist = !root.editing-playlist; }
                                else { root.delete-playlist-index = root.playlist-current; }
                            }
                            Text {
                                x: 13px; text: label; font-size: 13px; vertical-alignment: center;
                                color: choice == 1 ? #e11d48 : Palette.text;
                            }
                            opt-hit := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.playlist-options = false;
                                    if choice == 0 { root.editing-playlist = !root.editing-playlist; }
                                    else { root.delete-playlist-index = root.playlist-current; }
                                }
                            }
                        }
                    }
                }
            }
            if root.page == 4: ScrollView {
                horizontal-stretch: 1;
                vertical-scrollbar-policy: always-off;
                VerticalLayout {
                    x: 0px; width: min(968px, parent.width);
                    padding-left: 24px; padding-right: 24px; padding-top: 40px; padding-bottom: 16px;
                    spacing: 24px;
                    HorizontalLayout {
                        spacing: 8px; alignment: start;
                        for name[index] in ["Playback", "Appearance", "Library", "Tracking"]: Action {
                            width: index == 1 ? 114px : index == 2 ? 81px : 94px;
                            label: name;
                            muted-label: true;
                            active: root.settings-tab == index;
                            clicked => { root.settings-tab = index; }
                        }
                    }
                    if root.settings-tab == 0: SettingsCard {
                        Label { text: "Parametric EQ & normalization"; font-weight: 700; font-size: 16px; height: 23px; }
                        HorizontalLayout {
                            spacing: 10px; alignment: start;
                            Rectangle {
                                width: 22px; height: 22px;
                                accessible-role: checkbox; accessible-label: "Loudness normalizer";
                                accessible-action-default => { root.toggle-normalizer(); }
                                Rectangle {
                                    width: 17px; height: 17px; border-width: 1px; border-color: Palette.muted;
                                    background: root.normalizer-enabled ? Palette.selected : Palette.glass;
                                    if root.normalizer-enabled: Label { text: "✓"; color: Palette.text; horizontal-alignment: center; }
                                }
                                TouchArea { mouse-cursor: pointer; clicked => { root.toggle-normalizer(); } }
                            }
                            Label { text: "Loudness normalizer"; height: 22px; }
                        }
                        HorizontalLayout { padding-left: 28px; Text { text: "Reduces volume differences between tracks so quiet songs and loud songs play at a more even level."; wrap: word-wrap; color: Palette.muted; font-size: 12px; vertical-stretch: 0; horizontal-stretch: 1; } }
                        Rectangle { height: 22px; HorizontalLayout {
                            spacing: 10px; alignment: start;
                            accessible-role: checkbox; accessible-label: "Find lyrics online";
                            accessible-checked: root.online-lyrics;
                            accessible-action-default => { root.toggle-online-lyrics(); }
                            Rectangle {
                                width: 22px;
                                Rectangle {
                                    width: 17px; height: 17px; border-radius: 5px; border-width: 1px; border-color: Palette.muted;
                                    background: root.online-lyrics ? Palette.selected : Palette.glass;
                                    if root.online-lyrics: Text { text: "✓"; color: Palette.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            Label { text: "Find lyrics online"; }
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { root.toggle-online-lyrics(); } } }
                        HorizontalLayout { padding-left: 32px; Text { text: "When a track has no .lrc file or embedded lyrics, Sonic looks up its title, artist and album on LRCLIB (lrclib.net)."; wrap: word-wrap; color: Palette.muted; font-size: 12px; vertical-stretch: 0; horizontal-stretch: 1; } }
                        Label { text: "Preset or adjust each band (dB). Applied to playback."; height: 20px; color: Palette.muted; font-size: 13px; }
                        Rectangle {
                            height: 96px;
                            Rectangle { x: 32px; width: parent.width - 48px; y: 37px; height: 1px; background: Palette.border; }
                            if root.eq-area != "": Path {
                                x: 32px; y: 8px; width: parent.width - 48px; height: 58px;
                                viewbox-width: 1000; viewbox-height: 58;
                                commands: root.eq-area;
                                fill: @linear-gradient(180deg, Palette.accent.with-alpha(0.35) 0%, Palette.accent.with-alpha(0.05) 100%);
                            }
                            if root.eq-line != "": Path {
                                x: 32px; y: 8px; width: parent.width - 48px; height: 58px;
                                viewbox-width: 1000; viewbox-height: 58;
                                commands: root.eq-line; stroke: Palette.accent-ink; stroke-width: 2px;
                            }
                            for name[index] in ["25","35","49","69","97","137","192","270","380","534","750","1.1k","1.5k","2.1k","2.9k","4.1k","5.8k","8.1k","11.4k","16.0k"]: Label {
                                text: name; font-size: 8px; width: 30px;
                                x: 17px + index * (parent.width - 48px) / 19; y: 73px; height: 13px;
                                horizontal-alignment: center; color: Palette.muted;
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px; alignment: start;
                            Label { text: "Preamp"; width: 80px; color: Palette.muted; font-size: 13px; }
                            PlayerRange {
                                width: 120px; height: 28px; show-knob: true;
                                label: "Preamp gain"; maximum: 24; value: root.eq-preamp + 12;
                                updates-live: true;
                                committed(value) => { root.eq-level(round(value) - 12); }
                            }
                            Label { text: (root.eq-preamp > 0 ? "+" : "") + root.eq-preamp + " dB"; width: 60px; color: Palette.muted; font-size: 13px; }
                        }
                        HorizontalLayout {
                            spacing: 12px; alignment: start;
                            Label { text: "Preset"; width: 80px; color: Palette.muted; font-size: 13px; }
                            ComboBox { model: ["Flat", "Bass boost", "Treble boost", "Rock", "Jazz", "Classical", "Custom"]; width: 140px; current-index <=> root.eq-preset-index; selected => { root.eq-preset(self.current-index); } }
                        }
                        ScrollView {
                            min-width: 0px; height: 155px;
                            content-width: max(self.visible-width, 580px);
                            HorizontalLayout {
                            spacing: 1px;
                            for gain[index] in root.eq-gains: VerticalLayout {
                                spacing: 7px;
                                Label { text: (gain > 0 ? "+" : "") + gain; horizontal-alignment: center; font-size: 10px; height: 15px; color: Palette.muted; }
                                EqBandSlider { label: "EQ band " + (index + 1); value: gain; changed(value) => { root.eq-band(index, value); } }
                                Label {
                                    text: ["25","35","49","69","97","137","192","270","380","534","750","1.1k","1.5k","2.1k","2.9k","4.1k","5.8k","8.1k","11.4k","16.0k"][index];
                                    horizontal-alignment: center; font-size: 11px; height: 18px; color: Palette.muted;
                                }
                            }
                            }
                        }
                    }
                    if root.settings-tab == 1: SettingsCard {
                        Label { text: "Layout"; font-weight: 700; font-size: 16px; height: 23px; }
                        HorizontalLayout {
                            spacing: 12px; alignment: start;
                            Label { text: "Sidebar & panels"; width: 100px; color: Palette.muted; font-size: 13px; }
                            Action { width: 110px; label: root.layout-locked ? "Locked" : "Unlocked"; active: !root.layout-locked; clicked => { root.layout-locked = !root.layout-locked; } }
                            Label { text: root.layout-locked ? "Resizing disabled" : "Drag edges to resize"; width: 155px; color: Palette.muted; font-size: 12px; }
                        }
                    }
                    if root.settings-tab == 1: SettingsCard {
                        Label { text: "Theme"; font-weight: 700; font-size: 16px; height: 23px; }
                        Text { text: "Pick a color for backgrounds and accents. Text stays the same for readability."; wrap: word-wrap; color: Palette.muted; font-size: 13px; vertical-stretch: 0; }
                        HorizontalLayout {
                            spacing: 12px; alignment: start; height: 32px;
                            Label { text: "Theme color"; width: 90px; color: Palette.muted; font-size: 13px; }
                            Rectangle {
                                width: 44px; height: 32px; border-radius: 12px; border-width: 1px; border-color: Palette.hairline;
                                background: swatch.has-hover ? Palette.hover : Palette.background;
                                accessible-role: button; accessible-label: "Choose theme color";
                                accessible-action-default => { root.pick-theme-color(); }
                                Rectangle { x: 3px; y: 3px; width: parent.width - 6px; height: parent.height - 6px; border-radius: 9px; background: root.theme-swatch; border-width: 1px; border-color: Palette.hairline; }
                                swatch := TouchArea { mouse-cursor: pointer; clicked => { root.pick-theme-color(); } }
                            }
                            Rectangle {
                                width: 88px;
                                theme-input := LineEdit {
                                    width: 88px; height: 30px; font-size: 12px; text: root.theme-value; placeholder-text: "#0f172a";
                                    accepted => { root.save-theme(self.text); }
                                    focus-lost => { if self.text != root.theme-value { root.save-theme(self.text); } }
                                }
                            }
                        }
                        Rectangle { height: 6px; }
                        Rectangle { height: 22px; HorizontalLayout {
                            spacing: 10px; alignment: start;
                            accessible-role: checkbox; accessible-label: "Use album art color for theme when playing";
                            accessible-checked: root.auto-art-theme;
                            accessible-action-default => { root.auto-art-theme = !root.auto-art-theme; root.refresh-theme(); }
                            Rectangle {
                                width: 18px;
                                Rectangle {
                                    width: 17px; height: 17px; border-radius: 5px; border-width: 1px; border-color: Palette.muted;
                                    background: root.auto-art-theme ? Palette.selected : Palette.glass;
                                    if root.auto-art-theme: Text { text: "✓"; color: Palette.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            Label { text: "Use album art color for theme when playing"; font-size: 13px; }
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { root.auto-art-theme = !root.auto-art-theme; root.refresh-theme(); } } }
                        HorizontalLayout { padding-left: 28px; Text { text: "When checked, the theme color updates to the most prominent color from the now-playing album art."; wrap: word-wrap; font-size: 12px; color: Palette.muted; vertical-stretch: 0; horizontal-stretch: 1; } }
                        Rectangle { height: 6px; }
                        HorizontalLayout {
                            spacing: 12px; alignment: start; height: 32px;
                            Label { text: "Text"; width: 90px; color: Palette.muted; font-size: 13px; }
                            ComboBox { width: 196px; height: 32px; model: ["Auto (from theme color)", "Light text", "Dark text"]; current-index <=> root.text-mode; selected => { root.refresh-theme(); } }
                        }
                        HorizontalLayout { padding-left: 102px; Text { text: "Auto uses light text on dark themes and dark text on light themes."; wrap: word-wrap; font-size: 12px; color: Palette.muted; vertical-stretch: 0; horizontal-stretch: 1; } }
                    }
                    if root.settings-tab == 1: SettingsCard {
                        Label { text: "Font"; font-weight: 700; font-size: 16px; height: 23px; }
                        HorizontalLayout {
                            spacing: 12px; alignment: start;
                            Label { text: "App font"; width: 100px; color: Palette.muted; font-size: 13px; }
                            ComboBox { width: 143px; model: ["System default", "Georgia", "Inter", "Courier New", "Trebuchet MS", "Palatino"]; current-index <=> root.font-index; }
                        }
                    }
                    if root.settings-tab == 2: SettingsCard {
                        Label { text: "Local files"; font-size: 16px; font-weight: 700; height: 23px; }
                        Text { text: "Add music from a folder on your computer. Sonic creates SonicMusic in your Music folder; put MP3, M4A, FLAC, OGG, WAV there, then refresh to load them into your library."; wrap: word-wrap; color: Palette.muted; font-size: 13px; height: 40px; }
                        if !root.local-enabled: Action { width: 153px; label: "Enable local files"; clicked => { root.start-local(); } }
                        if root.local-enabled: Label { text: root.local-folder; height: 24px; color: Palette.muted; }
                        if root.local-enabled: HorizontalLayout {
                            alignment: start; spacing: 8px;
                            Action { width: 110px; label: "Open folder"; clicked => { root.open-local-folder(); } }
                            Action { width: 100px; label: "Refresh"; clicked => { root.refresh-library(); } }
                            Action { width: 150px; label: "Disable local files"; clicked => { root.start-local(); } }
                        }
                        if root.local-enabled: Label { text: root.local-status; height: 23px; color: Palette.muted; }
                    }
                    if root.settings-tab == 2: SettingsCard {
                        Label { text: "Plex account"; font-size: 16px; font-weight: 700; height: 23px; }
                        Label { text: root.connected || root.connecting ? root.status : root.status == "Connect Plex to browse your music." ? "Not connected" : root.status; color: Palette.muted; height: 24px; }
                        Action {
                            width: 140px;
                            label: root.connected ? "Sign out of Plex" : root.connecting ? "Connecting…" : "Sign in with Plex";
                            active: true;
                            clicked => { if root.connected { root.sign-out(); } else if !root.connecting { root.sign-in(); } }
                        }
                    }
                    if root.settings-tab == 2: SettingsCard {
                        Label { text: "Streaming quality"; font-size: 16px; font-weight: 700; height: 23px; }
                        Label { text: "The app uses your local network when possible. Choose quality for each case."; font-size: 13px; color: Palette.muted; height: 22px; }
                        HorizontalLayout {
                            spacing: 12px; alignment: start;
                            Label { text: "On local network"; width: 140px; color: Palette.muted; font-size: 13px; }
                            ComboBox { width: 130px; model: ["128 kbps", "256 kbps", "320 kbps", "Lossless"]; current-index <=> root.streaming-local; }
                        }
                        HorizontalLayout {
                            spacing: 12px; alignment: start;
                            Label { text: "On other networks"; width: 140px; color: Palette.muted; font-size: 13px; }
                            ComboBox { width: 130px; model: ["128 kbps", "256 kbps", "320 kbps", "Lossless"]; current-index <=> root.streaming-remote; }
                        }
                        if root.connected: Label { text: "Streaming: Direct — " + root.streaming-endpoint; font-size: 12px; color: Palette.muted; height: 20px; }
                        if root.connected: Label { text: "Connection: " + root.connection-type; font-size: 12px; color: Palette.muted; height: 20px; }
                        if root.connected: Action {
                            width: 218px;
                            label: root.refreshing-connection ? "Checking…" : "Refresh connection & streaming";
                            clicked => { root.refresh-connection(); }
                        }
                        if root.connected && root.connection-status != "": Label { text: root.connection-status; font-size: 12px; color: Palette.muted; height: 20px; }
                    }
                    if root.settings-tab == 2: SettingsCard {
                        Label { text: "Cache"; font-size: 16px; font-weight: 700; height: 23px; }
                        Text { text: "Clear API and image caches. Use if library or artwork is stale."; wrap: word-wrap; color: Palette.muted; }
                        HorizontalLayout {
                            alignment: start; spacing: 12px;
                            Action { width: 105px; label: "Reset cache"; clicked => { root.reset-art(); } }
                            if root.cache-status != "": Label { text: root.cache-status; font-size: 13px; color: Palette.muted; }
                        }
                    }
                    if root.settings-tab == 3: SettingsCard {
                        Label { text: "Discord Rich Presence"; font-size: 16px; font-weight: 700; height: 23px; }
                        Text {
                            text: "Show what you're listening to on Discord. Create an application at discord.com/developers, then copy its Application ID. The Discord desktop app must be running.";
                            wrap: word-wrap; color: Palette.muted; font-size: 13px; height: 38px;
                        }
                        HorizontalLayout {
                            height: 34px; spacing: 12px;
                            Label { text: "Application ID"; width: 120px; font-size: 13px; color: Palette.muted; }
                            LineEdit { text <=> root.discord-id; min-width: 0px; max-width: 245px; horizontal-stretch: 1; placeholder-text: "e.g. 1234567890123456789"; }
                            Action { width: 121px; height: 32px; active: true; label: "Test connection"; clicked => { root.discord-test(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            height: 34px; spacing: 12px;
                            Label { text: "Image key (optional)"; width: 120px; font-size: 13px; color: Palette.muted; }
                            LineEdit { text <=> root.discord-image; min-width: 0px; max-width: 245px; horizontal-stretch: 1; placeholder-text: "Art asset key from your app"; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Text { text: "Hover text on the image will show the album name."; wrap: word-wrap; font-size: 12px; color: Palette.muted; }
                        if root.discord-status != "": Label { text: root.discord-status; height: 22px; color: Palette.muted; }
                    }
                    if root.settings-tab == 3: SettingsCard {
                        Label { text: "Last.fm Scrobbling"; font-size: 16px; font-weight: 700; height: 23px; }
                        Label { text: root.lastfm-status; font-size: 13px; font-weight: 600; height: 20px; }
                        if !root.lastfm-connected: VerticalLayout {
                            spacing: 6px;
                            Text { text: "Enter your Last.fm API key and secret, then connect."; wrap: word-wrap; font-size: 13px; color: Palette.muted; }
                            Label { text: "API Key"; font-size: 13px; height: 20px; }
                            fm-key := LineEdit { placeholder-text: "Your Last.fm API key"; width: min(342px, parent.width); }
                            Label { text: "API Secret"; font-size: 13px; height: 20px; }
                            fm-secret := LineEdit { placeholder-text: "Your Last.fm API secret"; input-type: password; width: min(342px, parent.width); }
                            Action { height: 32px; label: "Connect to Last.fm"; active: true; clicked => { root.connect-lastfm(fm-key.text, fm-secret.text); fm-secret.text = ""; } }
                        }
                        if root.lastfm-pending: Action { label: "Finish Last.fm sign-in"; clicked => { root.approve-lastfm(); } }
                        if root.lastfm-connected: HorizontalLayout {
                            alignment: start; spacing: 8px;
                            Action { width: 112px; label: "Test connection"; clicked => { root.test-lastfm(); } }
                            Action { width: 134px; label: "Disconnect"; clicked => { root.disconnect-lastfm(); } }
                        }
                    }
                }
            }
        }
            footer := Rectangle {
                height: 91px;
                background: Palette.background;
                // The player floats as a rounded glass bar above the page edge.
                Rectangle {
                    x: 12px; y: 4px; width: parent.width - 24px; height: parent.height - 14px;
                    border-radius: 24px;
                    background: Palette.glass-sheen;
                    border-width: 1px; border-color: Palette.hairline;
                    drop-shadow-color: #00000040; drop-shadow-blur: 30px; drop-shadow-offset-y: 8px;
                }
                property <bool> show-meta: self.width >= 720px;
                property <bool> show-time: self.width >= 600px;
                property <bool> show-extra: self.width >= 600px;
                property <bool> show-volume: self.width >= 500px;
                art := Rectangle {
                    visible: root.page != 1;
                    x: 24px; y: 14px;
                    width: 56px; height: 56px;
                    background: Palette.surface; border-radius: 8px; clip: true;
                    Artwork { width: parent.width; height: parent.height; source: root.playing-art; }
                }
                if footer.show-meta && root.page != 1: VerticalLayout {
                    x: 92px; y: 4px; width: max(70px, parent.width / 2 - 225px);
                    height: parent.height - 14px; alignment: center; spacing: 2px;
                    HorizontalLayout {
                        height: 18px; spacing: 8px;
                        Label { text: root.track-title; font-weight: 600; horizontal-stretch: 1; }
                        if root.track-loading: Label { text: "Loading…"; font-size: 11px; color: Palette.muted; }
                    }
                    Label { text: root.track-artist; height: 16px; color: Palette.muted; font-size: 12px; }
                }
                VerticalLayout {
                    width: footer.show-extra ? min(440px, parent.width - 440px) : 160px;
                    x: (parent.width - self.width) / 2;
                    height: 54px; y: 4px + (parent.height - 14px - self.height) / 2;
                    spacing: 6px;
                    HorizontalLayout {
                        height: 34px; alignment: center; spacing: 6px;
                        if footer.show-extra: IconButton { width: 32px; height: 32px; compact: true; label: "Shuffle"; icon: @image-url("icons/shuffle.svg"); highlighted: root.shuffled; clicked => { root.shuffle(); } }
                        IconButton { width: 32px; height: 32px; compact: true; label: "Previous"; icon: @image-url("icons/prev.svg"); clicked => { root.previous-track(); } }
                        Rectangle { width: 0px; }
                        IconButton { width: 34px; height: 34px; compact: true; filled: true; label: root.playing ? "Pause" : "Play"; icon: root.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg"); clicked => { root.toggle-play(); } }
                        Rectangle { width: 0px; }
                        IconButton { width: 32px; height: 32px; compact: true; label: "Next"; icon: @image-url("icons/next.svg"); clicked => { root.next-track(); } }
                        if footer.show-extra: IconButton { width: 32px; height: 32px; compact: true; label: root.repeat-mode == 1 ? "Repeat all" : root.repeat-mode == 2 ? "Repeat one" : "Repeat off"; icon: @image-url("icons/repeat.svg"); badge: root.repeat-mode == 2 ? "1" : ""; highlighted: root.repeat-mode > 0; clicked => { root.repeat(); } }
                    }
                    HorizontalLayout {
                        spacing: 10px; height: 14px;
                        if footer.show-time: Label { text: root.elapsed; width: 32px; horizontal-alignment: right; color: Palette.muted; font-size: 11px; }
                        PlayerRange { label: "Seek"; smooth: root.playing; horizontal-stretch: 1; maximum: max(0.01, root.duration); value: root.position; committed(v) => { if root.duration > 0 { root.seek(v); } } }
                        if footer.show-time: Label { text: root.total; width: 32px; color: Palette.muted; font-size: 11px; }
                    }
                }
                HorizontalLayout {
                    width: footer.show-volume ? 166px : 28px; height: 36px; x: parent.width - self.width - 28px; y: (parent.height - 10px - self.height) / 2;
                    spacing: 8px;
                    if footer.show-volume: IconButton { width: 26px; compact: true; label: root.volume-level == 0 ? "Unmute" : "Mute"; icon: root.volume-level == 0 ? @image-url("icons/mute.svg") : @image-url("icons/volume.svg"); clicked => { root.mute(); } }
                    if footer.show-volume: PlayerRange { width: 96px; height: parent.height; label: "Volume"; maximum: 100; value: root.volume-level; updates-live: true; committed(v) => { root.volume(v / 100); } }
                    IconButton {
                        width: 28px; compact: true;
                        label: root.page == 1 ? "Exit fullscreen" : "Now Playing";
                        icon: root.page == 1 ? @image-url("icons/collapse.svg") : @image-url("icons/expand.svg");
                        clicked => {
                            if root.page == 1 { root.page = root.prior-page; root.sidebar-collapsed = false; }
                            else { root.prior-page = root.page; root.page = 1; }
                        }
                    }
                }
            }
        }
    }
    if root.playback-error != "": Rectangle {
        width: min(root.width * 0.9, 640px);
        height: 52px;
        x: (root.width - self.width) / 2; y: root.height - 80px - self.height;
        background: Palette.surface; border-color: Palette.hairline; border-width: 1px; border-radius: 16px;
        drop-shadow-color: #00000055; drop-shadow-blur: 24px; drop-shadow-offset-y: 8px;
        HorizontalLayout {
            padding-left: 16px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px; spacing: 12px;
            error-label := Label { text: root.playback-error; color: Palette.accent-ink; font-size: 13px; wrap: word-wrap; horizontal-stretch: 1; }
            Action { label: "Dismiss"; width: 72px; clicked => { root.playback-error = ""; } }
        }
    }
    if root.playlist-picker: Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        background: #00000099;
        TouchArea { clicked => { root.playlist-picker = false; picker-name.text = ""; } }
        Rectangle {
            width: min(236px, parent.width - 40px);
            height: min(parent.height * 0.8, picker-layout.preferred-height);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.surface; border-radius: 20px; border-width: 1px; border-color: Palette.hairline;
            drop-shadow-color: #00000066; drop-shadow-blur: 40px; drop-shadow-offset-y: 14px;
            clip: true;
            TouchArea { }
            picker-layout := VerticalLayout {
                padding: 20px; spacing: 0px;
                Label { text: "Add to playlist"; height: 34px; font-size: 19px; font-weight: 700; vertical-alignment: top; }
                VerticalLayout {
                    spacing: root.playlists.length == 0 ? 12px : 8px;
                    Label {
                        text: root.playlists.length == 0 ? "Create a new playlist and add this." : "Create new";
                        height: 16px; font-size: root.playlists.length == 0 ? 13px : 12px; color: Palette.muted;
                    }
                    picker-name := LineEdit {
                        height: 34px; font-size: 13px; placeholder-text: "Playlist name"; field-color: Palette.background;
                        init => { self.grab-focus(); }
                        accepted => {
                            root.create-playlist(self.text == "" ? "New Playlist" : self.text);
                            root.choose-playlist(root.playlist-target);
                        }
                        cancelled => { root.playlist-picker = false; self.text = ""; }
                    }
                    HorizontalLayout {
                        alignment: start; spacing: 8px; height: 34px;
                        Action { width: 112px; height: 34px; font-size: 13px; label: "Create and add"; active: true; clicked => {
                            root.create-playlist(picker-name.text == "" ? "New Playlist" : picker-name.text);
                            root.choose-playlist(root.playlist-target);
                        } }
                        if root.playlists.length == 0: Action { width: 70px; height: 34px; font-size: 13px; label: "Cancel"; clicked => { root.playlist-picker = false; picker-name.text = ""; } }
                    }
                }
                if root.playlists.length > 0: VerticalLayout {
                    padding-top: 12px; spacing: 6px;
                    Label { text: "Or add to existing"; height: 16px; font-size: 12px; color: Palette.muted; }
                    for name[index] in root.playlists: Rectangle {
                        height: 34px; border-radius: 10px; border-width: 1px; border-color: Palette.hairline;
                        background: existing.has-hover ? Palette.hover : Palette.background;
                        accessible-role: button; accessible-label: name;
                        accessible-action-default => { root.choose-playlist(index); }
                        Label { x: 12px; width: parent.width - 24px; text: name; font-size: 13px; }
                        existing := TouchArea { mouse-cursor: pointer; clicked => { root.choose-playlist(index); } }
                    }
                    HorizontalLayout {
                        alignment: start; padding-top: 6px;
                        Action { width: 70px; height: 34px; font-size: 13px; label: "Cancel"; clicked => { root.playlist-picker = false; picker-name.text = ""; } }
                    }
                }
            }
        }
    }
    if root.delete-playlist-index >= 0: Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        background: #00000099;
        TouchArea { clicked => { root.delete-playlist-index = -1; } }
        Rectangle {
            width: 300px; height: 136px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Palette.surface; border-radius: 20px; border-width: 1px; border-color: Palette.hairline;
            drop-shadow-color: #00000066; drop-shadow-blur: 40px; drop-shadow-offset-y: 14px;
            TouchArea { }
            VerticalLayout {
                padding: 20px; spacing: 8px;
                Label { text: "Delete this playlist?"; height: 24px; font-size: 17px; font-weight: 700; }
                Label {
                    text: root.delete-playlist-index < root.playlist-cards.length ? "“" + root.playlist-cards[root.delete-playlist-index].name + "” will be removed." : "";
                    height: 18px; font-size: 13px; color: Palette.muted;
                }
                HorizontalLayout {
                    alignment: end; spacing: 8px; padding-top: 6px; height: 40px;
                    Action { width: 76px; height: 34px; font-size: 13px; label: "Cancel"; clicked => { root.delete-playlist-index = -1; } }
                    Action { width: 76px; height: 34px; font-size: 13px; label: "Delete"; danger: true; clicked => {
                        root.delete-playlist-at(root.delete-playlist-index);
                        root.delete-playlist-index = -1;
                        root.editing-playlist = false;
                    } }
                }
            }
        }
    }
    // Sonic's own right-click menu (album, track, queue, search hit, playlist card).
    if root.menu-open: Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down { root.menu-open = false; }
            }
        }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.menu-open = false; return accept; }
                return reject;
            }
        }
        menu-panel := Rectangle {
            property <bool> plain: root.menu-kind == 3;
            property <[MenuEntry]> entries: self.plain
                ? [{ label: "Add to queue" }, { label: "Shuffle play" }, { label: "Delete", danger: true }]
                : [
                    { label: "Add to queue", icon: @image-url("icons/menu-queue.svg") },
                    { label: "Shuffle play", icon: @image-url("icons/menu-shuffle.svg") },
                    { label: "Add to playlist", icon: @image-url("icons/menu-add-playlist.svg") },
                ];
            property <length> item-height: self.plain ? 35px : 34px;
            width: self.plain ? 140px : 192px;
            height: 14px + self.entries.length * self.item-height;
            x: max(4px, min(root.menu-x, root.width - self.width - 4px));
            y: max(4px, min(root.menu-y, root.height - self.height - 4px));
            border-radius: self.plain ? 12px : 14px;
            border-width: 1px; border-color: Palette.hairline;
            background: Palette.surface;
            drop-shadow-color: #00000066; drop-shadow-blur: 40px; drop-shadow-offset-y: 14px;
            accessible-role: list;
            TouchArea { }
            VerticalLayout {
                padding-top: 7px; padding-bottom: 7px;
                padding-left: 6px; padding-right: 6px;
                for entry[choice] in menu-panel.entries: Rectangle {
                    height: menu-panel.item-height;
                    border-radius: menu-panel.plain ? 9px : 8px;
                    background: menu-hit.has-hover ? Palette.hover : transparent;
                    accessible-role: button;
                    accessible-label: entry.label;
                    accessible-action-default => { root.menu-choose(choice); }
                    HorizontalLayout {
                        padding-left: menu-panel.plain ? 13px : 14px; padding-right: 14px; spacing: 10px;
                        if !menu-panel.plain: Rectangle {
                            width: 18px;
                            Image {
                                x: 1px; y: (parent.height - 16px) / 2; width: 16px; height: 16px;
                                source: entry.icon; colorize: Palette.text;
                            }
                        }
                        Text {
                            text: entry.label; font-size: 13px; vertical-alignment: center;
                            color: entry.danger ? #ef4444 : Palette.text;
                        }
                    }
                    menu-hit := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.menu-choose(choice); }
                    }
                }
            }
        }
    }
}
